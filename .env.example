# Copy to .env and fill in as needed. All variables are optional; defaults shown.

# Primary database (full read/write).
DATABASE_URL=sqlite:///churnguard.db

# Read-only connection used by the agents' SQL tool. Defaults to a read-only
# view of DATABASE_URL for SQLite; for Postgres, point this at a role with
# SELECT-only grants on accounts, usage_daily and tickets.
AGENT_DATABASE_URL=

# LLM models for the two CrewAI agents (LiteLLM-style provider/model string).
ANALYST_MODEL=anthropic/claude-sonnet-5-5
CSM_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Set LLM_BASE_URL to use a local/self-hosted model instead, e.g. Ollama:
# ANALYST_MODEL=ollama/qwen2.5:7b
# CSM_MODEL=ollama/qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434
LLM_BASE_URL=

# Log CrewAI agent reasoning to stdout (1 = on).
CREW_VERBOSE=0

# Risk scoring / daily run tuning.
RISK_THRESHOLD=0.5
MAX_DAILY_FLAGS=15
HOLDOUT_RATE=0.2

# Flask review queue. Override before any shared/non-local deployment.
FLASK_SECRET_KEY=churnguard-local

# Optional: pull live support tickets from Zendesk instead of the local DB.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
